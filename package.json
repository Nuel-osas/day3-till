    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "pptxgenjs": "4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "24.x"
  }
