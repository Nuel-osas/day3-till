{
  "name": "day3-till",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "indexer": "node --env-file=.env --experimental-strip-types indexer/indexer.ts",
    "totals": "node --env-file=.env --experimental-strip-types indexer/totals.ts",
    "pay": "node --env-file=.env --experimental-strip-types scripts/pay.ts",
    "receipt": "node --experimental-strip-types scripts/receipt.ts",
    "migrate:legacy": "node --experimental-strip-types migration/legacy-jsonrpc.ts",
    "migrate:grpc": "node --experimental-strip-types migration/migrated-grpc.ts",
    "migrate:graphql": "node --experimental-strip-types migration/migrated-graphql.ts",
    "close": "node --env-file=.env --experimental-strip-types indexer/close.ts",
    "test": "tsx --test tests/*.test.ts",
    "slides": "node teaching/generate-slides.cjs"
  },
  "dependencies": {
    "@mysten/dapp-kit-react": "2.1.39",
    "@mysten/sui": "^2.36.0",
    "qrcode.react": "^4.2.0",
